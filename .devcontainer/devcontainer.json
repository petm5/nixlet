{
  "name": "Nix Dev Shell",
  "image": "mcr.microsoft.com/devcontainers/base:trixie",
  "customizations": {
    "vscode": {
      "extensions": [
        "bbenoist.Nix"
      ]
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/nix:1.3.1": {
      "extraNixConfig": "experimental-features = nix-command flakes"
    },
    "ghcr.io/devcontainers/features/sshd:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers-community/features/direnv": {}
  },
  "postCreateCommand": "direnv allow .",
  "customizations": {
    "codespaces": {
      "repositories": {
        "petm5/nixpkgs": {
          "permissions": {
            "contents": "write"
          }
        }
      }
    }
  }
}
