{
  "name": "Nix Dev Shell",
  "image": "ghcr.io/devcontainers/templates/alpine:3.4.0",
  "customizations": {
    "vscode": {
      "extensions": [
        "bbenoist.Nix"
      ]
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/nix:1.3.1": {
      "extraNixConfig": "experimental-features = nix-command flakes"
    }
  },
  "onCreateCommand": "nix develop"
}
